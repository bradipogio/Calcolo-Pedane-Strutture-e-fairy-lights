/* =========================================================
   DECK COLORS
========================================================= */

function calculateDeckColors(
  length,
  width
){

  const checker=
    document
      .getElementById(
        "checkerEnabled"
      )
      .checked;


  const cells=[];

  const counts={
    black:0,
    white:0,
    wood:0
  };


  if(!checker){

    const color=
      document
        .getElementById(
          "singleColor"
        )
        .value;


    for(
      let y=0;
      y<width;
      y++
    ){

      for(
        let x=0;
        x<length;
        x++
      ){

        cells.push({
          x,
          y,
          color
        });


        counts[color]++;

      }

    }

  }

  else{

    const colorA=
      document
        .getElementById(
          "checkerA"
        )
        .value;


    const colorB=
      document
        .getElementById(
          "checkerB"
        )
        .value;


    for(
      let y=0;
      y<width;
      y++
    ){

      for(
        let x=0;
        x<length;
        x++
      ){

        const color=

          (
            (x+y)%2===0
          )

          ?

          colorA

          :

          colorB;


        cells.push({
          x,
          y,
          color
        });


        counts[color]++;

      }

    }

  }


  return {
    cells,
    counts
  };

}



/* =========================================================
   YELLOW PANEL PATTERNS
========================================================= */

/*
  Numero minimo di pezzi usando 4 / 2 / 1.
*/

function minimumPieceCount(
  length
){

  const dp=
    Array(length+1)
      .fill(Infinity);


  dp[0]=0;


  for(
    let i=1;
    i<=length;
    i++
  ){

    for(const piece of YELLOW_LENGTHS){

      if(i-piece>=0){

        dp[i]=
          Math.min(
            dp[i],
            dp[i-piece]+1
          );

      }

    }

  }


  return dp[length];
}



/*
  Genera sequenze possibili con:
  minimo pezzi oppure massimo minimo + 1.

  È sufficiente per ottenere, per esempio:

  8m:
  [4,4]
  alternato con
  [2,4,2]
*/

function generatePanelPatterns(
  length
){

  const minPieces=
    minimumPieceCount(
      length
    );


  const maxPieces=
    minPieces+1;


  const results=[];

  const signatures=
    new Set();


  const MAX_RESULTS=2500;


  function dfs(
    sum,
    sequence
  ){

    if(
      results.length>=MAX_RESULTS
    ){

      return;

    }


    if(sum===length){

      if(
        sequence.length<=maxPieces
      ){

        const signature=
          sequence.join(",");


        if(
          !signatures.has(
            signature
          )
        ){

          signatures.add(
            signature
          );


          results.push(
            [...sequence]
          );

        }

      }


      return;

    }


    if(
      sum>length
      ||
      sequence.length>=maxPieces
    ){

      return;

    }


    /*
      4 prima per privilegiare
      naturalmente pezzi lunghi.
    */

    for(const piece of [4,2,1]){

      if(sum+piece<=length){

        sequence.push(piece);

        dfs(
          sum+piece,
          sequence
        );

        sequence.pop();

      }

    }

  }


  dfs(
    0,
    []
  );


  /*
    Sicurezza.
  */

  if(!results.length){

    results.push(
      Array(length).fill(1)
    );

  }


  return results;
}



/* =========================================================
   JOINTS
========================================================= */

function sequenceJoints(
  sequence
){

  const joints=[];

  let sum=0;


  for(
    let i=0;
    i<sequence.length-1;
    i++
  ){

    sum+=
      sequence[i];


    joints.push(sum);

  }


  return joints;
}



function alignedJointCount(
  sequenceA,
  sequenceB
){

  if(
    !sequenceA
    ||
    !sequenceB
  ){

    return 0;

  }


  const a=
    new Set(
      sequenceJoints(
        sequenceA
      )
    );


  let count=0;


  for(
    const joint
    of
    sequenceJoints(
      sequenceB
    )
  ){

    if(a.has(joint))
      count++;

  }


  return count;
}



/* =========================================================
   CHOOSE STAGGERED STRIPS
========================================================= */

function buildYellowStrips(
  stripLength,
  stripCount
){

  const patterns=
    generatePanelPatterns(
      stripLength
    );


  const strips=[];


  let totalAligned=0;


  for(
    let row=0;
    row<stripCount;
    row++
  ){

    const previous=
      strips[row-1]?.sequence
      ??
      null;


    let best=null;


    for(
      let p=0;
      p<patterns.length;
      p++
    ){

      const sequence=
        patterns[p];


      const aligned=
        alignedJointCount(
          previous,
          sequence
        );


      /*
        Alterniamo leggermente
        la preferenza per evitare che
        a parità di punteggio venga
        scelta sempre la stessa sequenza.
      */

      const edgeBias=

        row%2===0

        ?

        p*.000001

        :

        (
          patterns.length-p
        )*.000001;


      const score=

        aligned*10000

        +

        sequence.length*100

        +

        uniqueCount(sequence)

        +

        edgeBias;


      if(
        !best
        ||
        score<best.score
      ){

        best={
          sequence,
          aligned,
          score
        };

      }

    }


    strips.push({

      index:row,

      sequence:[
        ...best.sequence
      ],

      /*
        Prima e ultima fascia:
        laterale.
      */

      lateral:
        row===0
        ||
        row===stripCount-1

    });


    totalAligned+=
      best.aligned;

  }


  return {
    strips,
    totalAligned
  };

}



/* =========================================================
   YELLOW REQUIREMENTS
========================================================= */

function requirementsFromYellow(
  yellow
){

  const req={

    yellowNormal4:0,
    yellowNormal2:0,
    yellowNormal1:0,

    yellowSide4:0,
    yellowSide2:0,
    yellowSide1:0

  };


  for(const strip of yellow.strips){

    for(const piece of strip.sequence){

      const prefix=

        strip.lateral

        ?

        "yellowSide"

        :

        "yellowNormal";


      req[
        prefix+piece
      ]++;

    }

  }


  return req;
}



/* =========================================================
   YELLOW ORIENTATION
========================================================= */

function calculateYellowOrientation(
  length,
  width,
  orientation
){

  let stripLength;

  let stripCount;


  if(orientation==="length"){

    /*
      Pannelli lunghi sull'asse
      della LUNGHEZZA.

      Fasce da 50 cm
      lungo la larghezza.
    */

    stripLength=
      length;


    stripCount=
      Math.round(
        width/
        YELLOW_WIDTH
      );

  }

  else{

    /*
      Pannelli lunghi sull'asse
      della LARGHEZZA.

      Fasce da 50 cm
      lungo la lunghezza.
    */

    stripLength=
      width;


    stripCount=
      Math.round(
        length/
        YELLOW_WIDTH
      );

  }


  const arrangement=
    buildYellowStrips(
      stripLength,
      stripCount
    );


  const requirements=
    requirementsFromYellow(
      arrangement
    );


  const totalPieces=

    Object.values(
      requirements
    )
    .reduce(
      (sum,value)=>
        sum+value,
      0
    );


  const distinctSizes=

    Object.values(
      requirements
    )
    .filter(
      value=>value>0
    )
    .length;


  return {

    orientation,

    stripLength,

    stripCount,

    strips:
      arrangement.strips,

    alignedJoints:
      arrangement.totalAligned,

    requirements,

    totalPieces,

    distinctSizes

  };
}



/* =========================================================
   DEFICITS
========================================================= */

function deficitsFor(
  requirements
){

  if(!warehouseConfigured)
    return [];


  const deficits=[];


  Object.entries(
    requirements
  )
  .forEach(
    ([key,needed])=>{

      if(needed<=0)
        return;


      const available=
        remaining[key]
        ??
        0;


      if(needed>available){

        deficits.push({

          key,

          needed,

          available,

          missing:
            needed-
            available

        });

      }

    }
  );


  return deficits;
}



/* =========================================================
   AUTO ORIENTATION
========================================================= */

function chooseYellowLayout(
  length,
  width
){

  const setting=
    document
      .getElementById(
        "yellowOrientation"
      )
      .value;


  const candidates=

    setting==="auto"

    ?

    [
      calculateYellowOrientation(
        length,
        width,
        "length"
      ),

      calculateYellowOrientation(
        length,
        width,
        "width"
      )
    ]

    :

    [
      calculateYellowOrientation(
        length,
        width,
        setting
      )
    ];


  for(const candidate of candidates){

    candidate.deficits=
      deficitsFor(
        candidate.requirements
      );


    candidate.missing=

      candidate.deficits
      .reduce(
        (sum,item)=>
          sum+
          item.missing,
        0
      );

  }


  candidates.sort(
    (a,b)=>{


      /*
        Se il magazzino è impostato,
        prima cerchiamo una soluzione
        realmente caricabile.
      */

      if(warehouseConfigured){

        const aBad=
          a.deficits.length
          ?
          1
          :
          0;


        const bBad=
          b.deficits.length
          ?
          1
          :
          0;


        if(aBad!==bBad)
          return aBad-bBad;


        if(a.missing!==b.missing)
          return a.missing-b.missing;

      }


      /*
        PRIORITÀ STRUTTURALE:
        evitare giunte allineate.
      */

      if(
        a.alignedJoints!==
        b.alignedJoints
      ){

        return (
          a.alignedJoints-
          b.alignedJoints
        );

      }


      /*
        Poi meno pezzi.
      */

      if(
        a.totalPieces!==
        b.totalPieces
      ){

        return (
          a.totalPieces-
          b.totalPieces
        );

      }


      /*
        Poi meno tipi da caricare.
      */

      return (
        a.distinctSizes-
        b.distinctSizes
      );

    }
  );


  return candidates[0];
}



/* =========================================================
   MAIN PLAN
========================================================= */

function calculatePlan(){

  const length=
    Number(
      document
        .getElementById(
          "length"
        )
        .value
    );


  const width=
    Number(
      document
        .getElementById(
          "width"
        )
        .value
    );


  const name=

    document
      .getElementById(
        "projectName"
      )
      .value

    ||

    "Pedana";


  const valid=

    validIntegerDimension(
      length
    )

    &&

    validIntegerDimension(
      width
    );


  if(!valid){

    currentPlan={

      valid:false,

      name,

      length,

      width

    };


    renderInvalidPlan();

    return;

  }



  const deck=
    calculateDeckColors(
      length,
      width
    );


  const requirements=
    emptyRequirements();


  requirements.deckBlack=
    deck.counts.black;


  requirements.deckWhite=
    deck.counts.white;


  requirements.deckWood=
    deck.counts.wood;



  const yellowEnabled=

    document
      .getElementById(
        "yellowEnabled"
      )
      .checked;


  let yellow=null;


  if(yellowEnabled){

    yellow=
      chooseYellowLayout(
        length,
        width
      );


    Object.entries(
      yellow.requirements
    )
    .forEach(
      ([key,value])=>{

        requirements[key]+=
          value;

      }
    );

  }


  const deficits=
    deficitsFor(
      requirements
    );


  currentPlan={

    valid:true,

    name,

    length,

    width,

    area:
      length*
      width,

    deck,

    yellowEnabled,

    yellow,

    requirements,

    deficits

  };


  updateOrientationAutoLabel();

  renderAll();

}



