<!doctype html>
<html lang="it">

<head>

<meta charset="utf-8">

<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>

<title>Planner Pedane</title>


<style>

*{
  box-sizing:border-box;
}


body{
  margin:0;
  font-family:Arial,Helvetica,sans-serif;
  font-size:15px;
  background:#f3f4f6;
  color:#171717;
}


header{
  min-height:58px;
  padding:0 18px;

  background:#111;
  color:#fff;

  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
}


.header-left{
  display:flex;
  align-items:center;
  gap:18px;
}


header h1{
  margin:0;
  font-size:20px;
}


nav{
  display:flex;
  gap:5px;
}


nav a{
  color:#ccc;
  text-decoration:none;

  padding:7px 10px;

  border-radius:6px;

  font-size:13px;
  font-weight:700;
}


nav a:hover{
  background:#333;
  color:white;
}


nav a.active{
  background:white;
  color:#111;
}


button{
  border:0;
  border-radius:6px;

  padding:8px 11px;

  cursor:pointer;

  font-size:13px;
  font-weight:700;
}


button:disabled{
  opacity:.45;
  cursor:not-allowed;
}


.primary{
  background:#111;
  color:white;
}


.secondary{
  background:#e5e5e5;
  color:#111;
}


.active-button{
  background:#111 !important;
  color:white !important;
}


.page{
  max-width:1550px;
  margin:auto;
  padding:14px;
}


.card{
  background:white;

  border-radius:10px;

  padding:14px;
  margin-bottom:14px;

  box-shadow:0 1px 5px rgba(0,0,0,.1);
}


.workspace-header{
  display:flex;
  align-items:baseline;
  gap:12px;

  margin-bottom:11px;
}


.workspace-header h2{
  margin:0;
  font-size:21px;
}


.workspace-header span{
  color:#777;
  font-size:14px;
}


.workspace-grid{
  display:grid;

  grid-template-columns:
    275px
    minmax(390px,.95fr)
    minmax(420px,1.05fr);

  gap:12px;
}


.panel{
  min-width:0;

  padding:11px;

  border:1px solid #ddd;
  border-radius:8px;
}


.panel h3{
  margin:0 0 10px;
  font-size:15px;
}


label{
  display:block;

  margin-top:9px;

  font-size:13px;
  font-weight:700;
}


input[type=text],
input[type=number],
select{
  width:100%;

  margin-top:3px;
  padding:8px;

  border:1px solid #bbb;
  border-radius:5px;

  background:white;

  font-size:15px;
}


.two-cols{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:7px;
}


.checkbox-row{
  display:flex;
  align-items:center;
  gap:7px;

  margin-top:12px;

  font-size:14px;
  font-weight:700;
}


.checkbox-row input{
  margin:0;
}


.actions{
  display:flex;
  flex-wrap:wrap;
  gap:6px;

  margin-top:12px;
}


.small{
  color:#666;
  font-size:12px;
  line-height:1.45;
}


.subpanel{
  margin-top:10px;
  padding:9px;

  border:1px solid #ddd;
  border-radius:7px;

  background:#fafafa;
}


.subpanel.hidden{
  display:none;
}


.inline-selects{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:7px;
}


.auto-info{
  margin-top:4px;
  color:#666;
  font-size:11px;
}


/* =========================================================
   PLAN PREVIEW
========================================================= */

.preview-toolbar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;

  margin-bottom:7px;
}


.preview-toolbar span{
  color:#666;
  font-size:12px;
}


#deckPlan,
#yellowPlan{
  display:block;

  width:100%;
  height:300px;

  border:1px solid #ddd;
  border-radius:6px;

  background:#fafafa;
}


.legend{
  display:flex;
  flex-wrap:wrap;
  gap:10px;

  margin-top:7px;

  color:#555;
  font-size:12px;
}


.legend-item{
  display:flex;
  align-items:center;
  gap:5px;
}


.legend-box{
  width:16px;
  height:12px;
  border:1px solid #333;
}


.legend-yellow{
  background:#f0c729;
}


.legend-side{
  background:#f0c729;
  border:3px solid #b46b00;
}


/* =========================================================
   3D
========================================================= */

#viewer{
  width:100%;
  height:370px;

  overflow:hidden;

  border-radius:6px;

  background:#eef0f2;
}


.viewer-toolbar{
  display:flex;
  gap:6px;

  margin-bottom:7px;
}


/* =========================================================
   STATUS
========================================================= */

.status{
  margin-top:10px;

  padding-top:9px;

  border-top:1px solid #ddd;

  font-size:14px;
}


.good{
  color:#08752a;
  font-weight:700;
}


.bad{
  color:#b00020;
  font-weight:700;
}


.warning{
  margin-top:7px;
  padding:8px;

  border:1px solid #ddc06a;
  border-radius:6px;

  background:#fff3d2;
}


/* =========================================================
   RESULTS
========================================================= */

.results{
  display:grid;

  grid-template-columns:
    minmax(0,1.55fr)
    minmax(280px,.75fr);

  gap:12px;

  margin-top:12px;
}


.result-box{
  padding:10px;

  border:1px solid #ddd;
  border-radius:7px;
}


.result-box h3{
  margin:0 0 9px;

  font-size:15px;
}


/* =========================================================
   MATERIAL
========================================================= */

.material-box{
  border:3px solid #222;

  border-radius:8px;

  padding:11px;

  background:white;
}


.material-box.material-unavailable{
  border-color:#c40020;
  background:#fffafa;
}


.material-box h3{
  font-size:18px;
}


.material-list{
  display:grid;
  gap:4px;
}


.material-row{
  min-height:38px;

  display:grid;
  grid-template-columns:52px 1fr;

  gap:8px;

  align-items:center;

  padding:4px 6px;

  border-bottom:1px solid #ddd;
}


.material-row:last-child{
  border-bottom:0;
}


.material-qty{
  min-height:30px;

  display:flex;
  align-items:center;
  justify-content:center;

  border:2px solid #222;
  border-radius:5px;

  font-size:18px;
  font-weight:800;
}


.material-name{
  font-size:14px;
  font-weight:700;
  line-height:1.25;
}


/* =========================================================
   DATA
========================================================= */

.quick-data{
  display:grid;

  grid-template-columns:
    repeat(2,minmax(0,1fr));

  gap:7px;
}


.chip{
  padding:8px 9px;

  border:1px solid #ccc;
  border-radius:6px;

  background:#fafafa;

  font-size:12px;
}


.chip strong{
  display:block;

  margin-top:3px;

  font-size:16px;
}


.chip.total-chip{
  min-height:66px;

  border:2px solid #222;

  background:#fff;

  font-size:13px;
}


.chip.total-chip strong{
  font-size:22px;
  font-weight:800;
}


.chip.wide-chip{
  grid-column:1/-1;
}


/* =========================================================
   TECH DRAWINGS
========================================================= */

.drawings{
  display:grid;
  gap:12px;
}


.drawing{
  padding:9px;

  border:1px solid #ccc;
  border-radius:7px;
}


.drawing-title{
  margin-bottom:5px;

  font-size:15px;
  font-weight:700;
}


.drawing svg{
  display:block;

  width:100%;
  height:360px;
}


/* =========================================================
   SETTINGS
========================================================= */

#settingsModal{
  display:none;

  position:fixed;
  inset:0;

  z-index:30000;

  padding:30px;

  overflow:auto;

  background:rgba(0,0,0,.55);
}


#settingsModal.open{
  display:block;
}


.modal-box{
  max-width:720px;

  margin:auto;
  padding:20px;

  border-radius:10px;

  background:#fff;
}


.modal-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
}


.modal-head h2{
  margin:0;
}


.stock-grid{
  display:grid;

  grid-template-columns:1fr 90px;

  gap:7px 10px;

  align-items:center;

  margin-top:15px;
}


.stock-grid input{
  margin:0;
}


.settings-section{
  margin-top:20px;
  padding-top:14px;

  border-top:1px solid #ddd;
}


.settings-section h3{
  margin:0 0 8px;
  font-size:16px;
}


.stock-table{
  width:100%;

  border-collapse:collapse;

  font-size:13px;
}


.stock-table td{
  padding:5px;

  border-bottom:1px solid #ddd;
}


.stock-table td:last-child{
  text-align:right;
  font-weight:700;
}


.allocation{
  padding:7px 0;

  border-bottom:1px solid #ddd;

  font-size:13px;
}


/* =========================================================
   PRINT
========================================================= */

#printEventTitle,
#print3d{
  display:none;
}


@media(max-width:1120px){

  .workspace-grid{
    grid-template-columns:1fr 1fr;
  }

  .viewer-panel{
    grid-column:1/-1;
  }

}


@media(max-width:700px){

  header{
    align-items:flex-start;
    padding:10px;
  }

  .header-left{
    flex-direction:column;
    align-items:flex-start;
    gap:7px;
  }

  .workspace-grid,
  .results{
    grid-template-columns:1fr;
  }

}


@media print{

  body{
    background:white;
    font-size:13px;
  }


  header,
  .no-print,
  .workspace-header,
  .workspace-grid,
  .status,
  #viewer{
    display:none !important;
  }


  .page{
    max-width:none;
    padding:0;
  }


  .card{
    padding:5px 0;

    border:0;

    box-shadow:none;
  }


  #printEventTitle{
    display:block;

    margin:0 0 12px;
    padding:0 0 8px;

    border-bottom:2px solid #000;

    font-size:28px;
    font-weight:800;
  }


  #print3d{
    display:block;

    width:100%;
    height:300px;

    margin:0 0 12px;

    object-fit:contain;

    break-inside:avoid;
  }


  .results{
    display:grid;

    grid-template-columns:
      1.35fr
      .85fr;

    gap:10px;

    align-items:start;

    margin-top:0;
  }


  .material-box{
    border:3px solid #000;
    break-inside:avoid;
  }


  .material-box.material-unavailable{
    border-color:#c40020 !important;
  }


  .material-row{
    min-height:34px;

    grid-template-columns:48px 1fr;
  }


  .material-qty{
    border:2px solid #000;

    font-size:17px;
  }


  .drawing{
    break-inside:avoid;
  }


  .drawing svg{
    height:320px;
  }

}

</style>


<script type="importmap">

{
  "imports":{
    "three":
      "https://cdn.jsdelivr.net/npm/three/build/three.module.js",

