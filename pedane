    Math.min(

      (1000-margin*2)/
      plan.length,

      (520-margin*2)/
      plan.width

    );


  const originX=
    (1000-plan.length*scale)/2;


  const originY=
    (520-plan.width*scale)/2;


  let html="";


  yellow.strips.forEach(strip=>{

    let offset=0;


    strip.sequence.forEach(
      (
        piece,
        pieceIndex
      )=>{


        let x;

        let y;

        let w;

        let h;


        if(
          yellow.orientation==="length"
        ){

          x=
            originX+
            offset*
            scale;


          y=
            originY+
            strip.index*
            YELLOW_WIDTH*
            scale;


          w=
            piece*
            scale;


          h=
            YELLOW_WIDTH*
            scale;

        }

        else{

          x=
            originX+
            strip.index*
            YELLOW_WIDTH*
            scale;


          y=
            originY+
            offset*
            scale;


          w=
            YELLOW_WIDTH*
            scale;


          h=
            piece*
            scale;

        }


        html+=`

          <rect

            x="${x}"
            y="${y}"

            width="${w}"
            height="${h}"

            fill="#f0c729"

            stroke="${
              strip.lateral
              ?
              "#a95e00"
              :
              "#725e00"
            }"

            stroke-width="${
              strip.lateral
              ?
              3
              :
              1.5
            }"

          />

        `;



        /*
          Lunghezza pezzo.
        */

        if(
          w>38
          &&
          h>22
        ){

          html+=`

            <text

              x="${x+w/2}"
              y="${y+h/2+4}"

              text-anchor="middle"

              font-family="Arial"

              font-size="12"

              font-weight="700"

            >
              ${piece}m
            </text>

          `;

        }



        /*
          L sui laterali.
        */

        if(
          strip.lateral
          &&
          w>22
          &&
          h>18
        ){

          html+=`

            <text

              x="${x+8}"
              y="${y+14}"

              font-family="Arial"

              font-size="11"

              font-weight="800"

              fill="#8b4300"

            >
              L
            </text>

          `;

        }


        offset+=
          piece;

      }
    );

  });



  html+=`

    <text

      x="500"
      y="25"

      text-anchor="middle"

      font-family="Arial"

      font-size="15"

      font-weight="700"

    >
      ${
        yellow.orientation==="length"
        ?
        "Pannelli orientati lungo la lunghezza"
        :
        "Pannelli orientati lungo la larghezza"
      }
    </text>

  `;


  svg.innerHTML=
    html;

}



/* =========================================================
   THREE
========================================================= */

function init3D(){

  const container=
    document
      .getElementById(
        "viewer"
      );


  renderer=
    new THREE.WebGLRenderer({

      antialias:true,

      preserveDrawingBuffer:true

    });


  renderer.setPixelRatio(

    Math.min(
      devicePixelRatio,
      2
    )

  );


  renderer.setSize(

    container.clientWidth,

    container.clientHeight

  );


  container.appendChild(
    renderer.domElement
  );


  camera=
    new THREE.PerspectiveCamera(

      45,

      container.clientWidth/
      container.clientHeight,

      .1,

      1000

    );


  controls=
    new OrbitControls(

      camera,

      renderer.domElement

    );


  controls.enableDamping=true;


  controls.addEventListener(
    "start",
    ()=>{

      cameraUserAdjusted=true;

    }
  );


  window.addEventListener(
    "resize",
    resize3D
  );


  animate();

}



function resize3D(){

  const container=
    document
      .getElementById(
        "viewer"
      );


  renderer.setSize(

    container.clientWidth,

    container.clientHeight

  );


  camera.aspect=

    container.clientWidth/
    container.clientHeight;


  camera.updateProjectionMatrix();

}



function animate(){

  requestAnimationFrame(
    animate
  );


  controls?.update();


  if(
    renderer
    &&
    scene
    &&
    camera
  ){

    renderer.render(
      scene,
      camera
    );

  }

}



/* =========================================================
   3D RENDER
========================================================= */

function render3D(){

  const plan=
    currentPlan;


  scene=
    new THREE.Scene();


  scene.background=
    new THREE.Color(
      0xf1f2f3
    );


  scene.add(

    new THREE.HemisphereLight(

      0xffffff,

      0x777777,

      2.4

    )

  );


  const maxDimension=

    Math.max(
      plan.length,
      plan.width,
      4
    );


  let gridSize=

    Math.ceil(
      maxDimension+8
    );


  if(gridSize%2!==0)
    gridSize++;


  const grid=
    new THREE.GridHelper(

      gridSize,

      gridSize

    );


  grid.position.set(

    plan.length/2,

    -.01,

    plan.width/2

  );


  scene.add(grid);



  /*
    GIALLI
  */

  if(
    plan.yellowEnabled
  ){

    const yellowMaterial=
      new THREE.MeshStandardMaterial({
        color:0xe6bc20
      });


    const sideMaterial=
      new THREE.MeshStandardMaterial({
        color:0xd7a512
      });


    plan.yellow.strips
      .forEach(strip=>{

        let offset=0;


        strip.sequence.forEach(piece=>{

          let geometry;

          let x;

          let z;


          if(
            plan.yellow.orientation===
            "length"
          ){

            geometry=
              new THREE.BoxGeometry(

                piece-.018,

                .07,

                YELLOW_WIDTH-.018

              );


            x=
              offset+
              piece/2;


            z=
              strip.index*
              YELLOW_WIDTH+
              YELLOW_WIDTH/2;

          }

          else{

            geometry=
              new THREE.BoxGeometry(

                YELLOW_WIDTH-.018,

                .07,

                piece-.018

              );


            x=
              strip.index*
              YELLOW_WIDTH+
              YELLOW_WIDTH/2;


            z=
              offset+
              piece/2;

          }


          const mesh=
            new THREE.Mesh(

              geometry,

              strip.lateral
              ?
              sideMaterial
              :
              yellowMaterial

            );


          mesh.position.set(

            x,

            .045,

            z

          );


          scene.add(mesh);


          offset+=piece;

        });

      });

  }



  /*
    QUADROTTI
  */

  if(showDeck){

    const materialCache={};


    Object.entries(
      COLOR_INFO
    )
    .forEach(
      ([key,value])=>{

        materialCache[key]=
          new THREE.MeshStandardMaterial({

            color:
              value.three,

            roughness:.85

          });

      }
    );


    for(
      const cell
      of
      plan.deck.cells
    ){

      const geometry=
        new THREE.BoxGeometry(

          .97,

          .09,

          .97

        );


      const mesh=
        new THREE.Mesh(

          geometry,

          materialCache[
            cell.color
          ]

        );


      mesh.position.set(

        cell.x+.5,

        plan.yellowEnabled
        ?
        .145
        :
        .055,

        cell.y+.5

      );


      scene.add(mesh);

    }

  }



  /*
    CAMERA

    Come nell'altro planner:
    dopo che la tocchi manualmente
    non viene resettata.
  */

  if(
    !hasRendered3D
    ||
    !cameraUserAdjusted
  ){

    const center=
      new THREE.Vector3(

        plan.length/2,

        0,

        plan.width/2

      );


    const distance=

      Math.max(
        plan.length,
        plan.width,
        5
      );


    camera.position.set(

      center.x+
      distance*.72,

      distance*.7,

      center.z+
      distance*.9

    );


    controls.target.set(

      center.x,

      0,

      center.z

    );


    controls.update();


    hasRendered3D=true;

  }

}



