<script type="module">


import * as THREE
from "three";


import {
  OrbitControls
}
from "three/addons/controls/OrbitControls.js";



/* =========================================================
   CONSTANTS
========================================================= */

const YELLOW_WIDTH = .5;

const YELLOW_LENGTHS = [4,2,1];


const ITEMS = [


  {
    key:"deckBlack",
    label:"Quadrotto nero 1 × 1 m"
  },


  {
    key:"deckWhite",
    label:"Quadrotto bianco 1 × 1 m"
  },


  {
    key:"deckWood",
    label:"Quadrotto legno 1 × 1 m"
  },


  {
    key:"yellowNormal4",
    label:"Pannello giallo normale 4 m"
  },


  {
    key:"yellowNormal2",
    label:"Pannello giallo normale 2 m"
  },


  {
    key:"yellowNormal1",
    label:"Pannello giallo normale 1 m"
  },


  {
    key:"yellowSide4",
    label:"Pannello giallo laterale 4 m"
  },


  {
    key:"yellowSide2",
    label:"Pannello giallo laterale 2 m"
  },


  {
    key:"yellowSide1",
    label:"Pannello giallo laterale 1 m"
  }


];


const COLOR_INFO = {


  black:{
    label:"Nero",
    css:"#181818",
    three:0x181818
  },


  white:{
    label:"Bianco",
    css:"#f6f6f2",
    three:0xf2f2ec
  },


  wood:{
    label:"Legno",
    css:"#a77746",
    three:0xa77746
  }


};



/* =========================================================
   STATE
========================================================= */

let warehouse={};

let remaining={};

let allocations=[];

let warehouseConfigured=false;


let currentPlan=null;

let lastCommittedSignature=null;


let renderer;

let scene;

let camera;

let controls;


let cameraUserAdjusted=false;

let hasRendered3D=false;


let showDeck=true;



/* =========================================================
   BASIC UTILS
========================================================= */

function itemLabel(key){

  return (
    ITEMS.find(
      item=>item.key===key
    )?.label
    ||
    key
  );
}



function emptyRequirements(){

  const result={};


  ITEMS.forEach(item=>{

    result[item.key]=0;

  });


  return result;
}



function colorStockKey(
  color
){

  if(color==="black")
    return "deckBlack";


  if(color==="white")
    return "deckWhite";


  return "deckWood";
}



function validIntegerDimension(
  value
){

  return (
    Number.isInteger(value)
    &&
    value>=1
  );
}



function uniqueCount(
  sequence
){

  return new Set(sequence).size;
}



/* =========================================================
   STORAGE
========================================================= */

const STORAGE_KEY=
  "pedanePlannerState_v1";


function loadPersistentState(){

  const saved=
    localStorage.getItem(
      STORAGE_KEY
    );


  if(!saved)
    return;


  try{

    const data=
      JSON.parse(saved);


    if(data.warehouse){

      warehouse={
        ...data.warehouse
      };


      warehouseConfigured=true;

    }


    if(data.remaining){

      remaining={
        ...data.remaining
      };

    }

    else if(warehouseConfigured){

      remaining={
        ...warehouse
      };

    }


    if(
      Array.isArray(
        data.allocations
      )
    ){

      allocations=
        data.allocations;

    }

  }

  catch(error){

    console.warn(
      "Impossibile leggere il salvataggio pedane.",
      error
    );

  }

}



function persistState(){

  localStorage.setItem(

    STORAGE_KEY,

    JSON.stringify({

      warehouse,

      remaining,

      allocations

    })

  );

}



/* =========================================================
   STOCK UI
========================================================= */

function createStockInputs(){

  const root=
    document.getElementById(
      "stockInputs"
    );


  root.innerHTML="";


  ITEMS.forEach(item=>{

    const label=
      document.createElement(
        "div"
      );


    label.textContent=
