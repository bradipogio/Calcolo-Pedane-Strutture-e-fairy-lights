/* =========================================================
   COMMIT
========================================================= */

function commitPlan(){

  if(
    !currentPlan?.valid
  ){

    return;

  }


  if(
    !warehouseConfigured
  ){

    alert(
      "Prima imposta il magazzino nei Settings."
    );

    return;

  }


  if(
    currentPlan.deficits.length
  ){

    alert(
      "Materiale insufficiente."
    );

    return;

  }


  const signature=
    planSignature(
      currentPlan
    );


  if(
    signature===
    lastCommittedSignature
  ){

    return;

  }


  Object.entries(
    currentPlan.requirements
  )
  .forEach(
    ([key,quantity])=>{

      if(quantity){

        remaining[key]-=
          quantity;

      }

    }
  );


  allocations.push({

    name:
      currentPlan.name,

    length:
      currentPlan.length,

    width:
      currentPlan.width,

    requirements:{
      ...currentPlan.requirements
    }

  });


  lastCommittedSignature=
    signature;


  persistState();

  renderRemaining();

  renderAllocations();

  calculatePlan();

}



/* =========================================================
   ALLOCATIONS
========================================================= */

function renderAllocations(){

  const root=
    document
      .getElementById(
        "allocations"
      );


  if(!allocations.length){

    root.textContent=
      "Nessuno.";

    return;

  }


  root.innerHTML=

    allocations
    .map(
      (item,index)=>`

        <div class="allocation">

          <strong>
            ${index+1}. ${item.name}
          </strong>

          ·

          ${item.length}
          ×
          ${item.width} m

        </div>

      `
    )
    .join("");

}



