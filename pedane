/* =========================================================
   DECK SVG
========================================================= */

function deckSvgMarkup(
  widthPx,
  heightPx
){

  const plan=
    currentPlan;


  const margin=28;


  const scale=

    Math.min(

      (widthPx-margin*2)/
      plan.length,

      (heightPx-margin*2)/
      plan.width

    );


  const totalW=
    plan.length*
    scale;


  const totalH=
    plan.width*
    scale;


  const originX=
    (widthPx-totalW)/2;


  const originY=
    (heightPx-totalH)/2;


  let html="";


  for(
    const cell
    of
    plan.deck.cells
  ){

    const color=
      COLOR_INFO[
        cell.color
      ];


    html+=`

      <rect

        x="${
          originX+
          cell.x*
          scale
        }"

        y="${
          originY+
          cell.y*
          scale
        }"

        width="${scale}"

        height="${scale}"

        fill="${color.css}"

        stroke="#444"

        stroke-width="1.4"

      />

    `;

  }



  html+=`

    <text
      x="${widthPx/2}"
      y="${originY-8}"
      text-anchor="middle"
      font-family="Arial"
      font-size="14"
      font-weight="700"
    >
      ${plan.length.toFixed(2)} m
    </text>


    <text
      x="${originX-10}"
      y="${heightPx/2}"
      text-anchor="middle"
      font-family="Arial"
      font-size="14"
      font-weight="700"
      transform="
        rotate(
          -90
          ${originX-10}
          ${heightPx/2}
        )
      "
    >
      ${plan.width.toFixed(2)} m
    </text>

  `;


  return html;
}



